{
  "entities": {
    "Store": {
      "title": "Store",
      "description": "Medical Store or Pharmacy profile and credentials",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "storeName": { "type": "string" },
        "ownerName": { "type": "string" },
        "phone": { "type": "string" },
        "pin": { "type": "string" },
        "address": { "type": "string" },
        "dlNumber": { "type": "string" },
        "gstin": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "blocked", "pending"] },
        "planType": { "type": "string" },
        "minRedeemPoints": { "type": "number" },
        "pointValueInRs": { "type": "number" },
        "whatsappMessageTemplate": { "type": "string" },
        "redeemMessageTemplate": { "type": "string" },
        "medicineReminderTemplate": { "type": "string" },
        "registeredAt": { "type": "string" }
      },
      "required": ["id", "storeName", "ownerName", "phone", "pin"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer of a medical store with loyalty points",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "storeId": { "type": "string" },
        "name": { "type": "string" },
        "mobile": { "type": "string" },
        "currentPoints": { "type": "number" },
        "totalPointsEarned": { "type": "number" },
        "totalSpent": { "type": "number" },
        "totalBills": { "type": "number" }
      },
      "required": ["id", "storeId", "mobile", "name"]
    },
    "Bill": {
      "title": "Bill",
      "description": "Sales invoice generated by a medical store",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "storeId": { "type": "string" },
        "billNumber": { "type": "string" },
        "customerMobile": { "type": "string" },
        "customerName": { "type": "string" },
        "finalAmount": { "type": "number" },
        "date": { "type": "string" }
      },
      "required": ["id", "storeId", "billNumber", "finalAmount"]
    }
  },
  "firestore": {
    "/stores/{storeId}": {
      "schema": { "$ref": "#/entities/Store" },
      "description": "Registered pharmacy profile and login credentials"
    },
    "/stores/{storeId}/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Customers belonging strictly to a pharmacy"
    },
    "/stores/{storeId}/bills/{billId}": {
      "schema": { "$ref": "#/entities/Bill" },
      "description": "Invoices belonging strictly to a pharmacy"
    },
    "/stores/{storeId}/tabs/{tabId}": {
      "schema": "object",
      "description": "Category tabs and loyalty rates for the pharmacy"
    },
    "/stores/{storeId}/transactions/{txnId}": {
      "schema": "object",
      "description": "Points history"
    },
    "/stores/{storeId}/reminders/{reminderId}": {
      "schema": "object",
      "description": "Medicine refill reminders"
    }
  }
}
